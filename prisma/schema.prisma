// prisma/schema.prisma
// Enterprise PostgreSQL Database Schema for Student Laptop Scheme 2026

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DegreeLevel {
  Matric
  Intermediate
  Undergraduate
  Postgraduate
}

enum ApplicationStatus {
  SUBMITTED
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  UNDER_REVIEW
  MERIT_APPROVED
  MERIT_WAITLISTED
  REJECTED
}

model Student {
  id              String            @id @default(cuid())
  applicationNo   String            @unique
  cnic            String            @unique
  fullName        String
  fatherName      String
  dateOfBirth     DateTime
  gender          String
  mobileNo        String
  email           String?
  province        String
  district        String
  tehsil          String
  currentAddress  String

  // Academic Details
  degreeLevel     DegreeLevel
  instituteName   String
  boardUniversity String
  rollNumber      String
  passingYear     Int
  totalMarks      Float
  obtainedMarks   Float
  percentage      Float

  status          ApplicationStatus @default(PAYMENT_PENDING)

  // One-to-One Relation with Challan
  challan         Challan?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([cnic])
  @@index([applicationNo])
  @@index([status])
  @@map("students")
}

model Challan {
  id              String            @id @default(cuid())
  psid            String            @unique
  amount          Float             @default(1500.00)
  dueDate         DateTime
  isPaid          Boolean           @default(false)
  transactionId   String?           @unique
  receiptUrl      String?
  verifiedByAdmin Boolean           @default(false)

  // Relation to Student
  studentId       String            @unique
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([psid])
  @@index([transactionId])
  @@map("challans")
}

model InstituteDataset {
  id        String   @id @default(cuid())
  name      String
  city      String
  province  String
  type      String   // Board, School, College, University

  createdAt DateTime @default(now())

  @@index([name])
  @@index([city])
  @@index([province])
  @@index([type])
  @@map("institute_datasets")
}
